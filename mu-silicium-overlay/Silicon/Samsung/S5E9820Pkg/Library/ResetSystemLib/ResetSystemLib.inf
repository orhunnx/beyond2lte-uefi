#
#  NOT: HwResetSystemLib (MU_CHANGE sinifi) burada da beyan edilir. DSC
#  (S5E9820Pkg.dsc.inc) HwResetSystemLib ve ResetSystemLib'in IKISINI de bu
#  modula baglar (ResetSystemRuntimeDxe HwResetSystemLib kullanir). Yalnizca
#  ResetSystemLib beyan edilirse derleme
#  "does not support LIBRARY_CLASS HwResetSystemLib" uyarisi verir.
#
#  Iki AYRI satir kullanildi: bu BaseTools'un INF ayristiricisi
#  (InfBuildData.py) LIBRARY_CLASS'in '|' oncesini TEK sinif adi olarak alir
#  (GetSplitValueList -> ValueList[0]). "A B|TYPE" bicimi "A B" diye tek
#  sinif sayilir ve hicbir eslesme olmaz. Bu yuzden her sinif kendi satirinda.
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ResetSystemLib
  FILE_GUID                      = AE855820-4BC5-405B-8BFF-245596D146C7
  MODULE_TYPE                    = DXE_RUNTIME_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ResetSystemLib|DXE_RUNTIME_DRIVER
  LIBRARY_CLASS                  = HwResetSystemLib|DXE_RUNTIME_DRIVER
  CONSTRUCTOR                    = ResetSystemLibConstructor

[Sources]
  ResetSystem.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec
  SamsungPkg/SamsungPkg.dec

[LibraryClasses]
  DebugLib
  UefiBootServicesTableLib
  MemoryMapHelperLib
  IoLib

[Protocols]
  gEfiPmicExtraProtocolGuid
