[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = B2LPlatformBootManagerLib
  FILE_GUID                      = C4E7A1B2-3D5F-4A68-9B21-7E0C5D8F3A46
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = DeviceBootManagerLib|DXE_DRIVER

#
# DeviceBootManagerLib yerine geciyor: "no OS" aninda kapanmak yerine
# S10e donanim self-test ekranini cizer (bkz. B2LPlatformBootManager.c).
#

[Sources]
  B2LPlatformBootManager.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MsCorePkg/MsCorePkg.dec
  SiliciumPkg/SiliciumPkg.dec
  PcBdsPkg/PcBdsPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DevicePathLib
  DxeServicesTableLib
  IoLib
  MemoryAllocationHelperLib
  PcdLib
  UefiLib
  UefiBootManagerLib
  UefiBootServicesTableLib
  MemoryAllocationLib
  PrintLib

[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiAbsolutePointerProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gEfiFirmwareVolume2ProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiUsbFunctionIoProtocolGuid

#
# M3c: FV'deki UEFI Shell'i isaret eden boot option, MsBootOptionsLib'in
# kullandigi PCD ile AYNI GUID'den turetilir (tek kaynak: DSC).
#
[Pcd]
  gPcBdsPkgTokenSpaceGuid.PcdShellFile