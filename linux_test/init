#!/bin/busybox sh
#
# Minik initramfs /init - kernel'in ACPI hakkinda ne dusundugunu raporlar.
#
# DORT KURAL, DORDU DE BIRER TUR MALIYETINDE OGRENILDI:
#
# 1) Shebang "#!/bin/busybox sh" olmali, "#!/bin/sh" DEGIL.
#
# 2) Ilk is "busybox --install -s" olmali. Alpine'in initramfs'inde applet
#    sembolik baglari ONCEDEN YOK (Alpine'in kendi init'i de ayni komutla
#    basliyor). Bunlar olmadan mount/dmesg/ls/poweroff bulunamiyor:
#    "Kernel panic: Attempted to kill init! exitcode=0x00007f00" (0x7f00>>8=127).
#
# 3) CIKTI /dev/kmsg UZERINDEN GITMELI. init'in stdout'u hicbir yere bagli
#    olmayabiliyor: kernel /dev/console dugumunu acamazsa init fd'siz basliyor
#    ve butun echo'lar sessizce kayboluyor. Bir tur boyle gecti - panik yoktu,
#    cikti da yoktu. /dev/kmsg'e yazilan satir kernel halkasina girip zaten
#    gorebildigimiz printk yolundan ekrana dusuyor.
#
# 4) Script ASLA cikmamali; cikarsa panik ekrani yazdiklarimizi bastiriyor.
#
/bin/busybox mkdir -p /proc /sys /dev /mnt /bin /sbin
/bin/busybox mount -t proc     none /proc 2>/dev/null
/bin/busybox mount -t sysfs    none /sys  2>/dev/null
/bin/busybox mount -t devtmpfs none /dev  2>/dev/null

# devtmpfs baglanmadiysa dugumleri elle ac (initramfs tmpfs, mknod calisir)
/bin/busybox test -c /dev/kmsg    || /bin/busybox mknod -m 600 /dev/kmsg    c 1 11 2>/dev/null
/bin/busybox test -c /dev/console || /bin/busybox mknod -m 622 /dev/console c 5 1  2>/dev/null

/bin/busybox test -c /dev/console && exec >/dev/console 2>&1 </dev/console

/bin/busybox --install -s /bin
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

# Hem ekrana hem kernel halkasina. Onemli olan ikincisi.
say() {
    echo "$*"
    echo "B2L: $*" > /dev/kmsg 2>/dev/null
}
sayp() {   # borudan gelen satirlari tek tek gecir
    while read -r l; do say "  $l"; done
}

say "======== beyond2lte ACPI testi ========"

say "-- CPU"
say "   online  : $(cat /sys/devices/system/cpu/online 2>/dev/null)"
say "   possible: $(cat /sys/devices/system/cpu/possible 2>/dev/null)"

say "-- SMP sonucu"
dmesg | grep -i -E 'SMP:|Brought up' | head -3 | sayp

#
# Windows "winload.efi / 0xc0000487" ile duruyor. Kod belgelenmemis; bilinen
# tek somut anomali cekirdekler arasi ozellik farki:
#   SANITY CHECK: Unexpected variation in SYS_ID_AA64ISAR0_EL1
#   Boot CPU: 0x10305400   CPU6: 0x10305410      <- fark [7:4] = AES alani
# Yani M4'lerde kripto var, ACILISIN YAPILDIGI A55'te yok. winload CPU
# ozelliklerini boot islemcisinden okuyorsa aday sebep bu.
#
say "-- cpu0 ozellikleri (boot islemcisi)"
say "   $(grep -m1 '^Features' /proc/cpuinfo 2>/dev/null)"
say "-- cpu7 ozellikleri (M4, karsilastirma)"
say "   $(grep '^Features' /proc/cpuinfo 2>/dev/null | tail -1)"
say "-- ID kayitlari"
dmesg | grep -i -E 'SANITY CHECK|feature variation' | head -6 | sayp

#
# ==========================================================================
# WINDOWS ICIN KRITIK OLAN, HIC DOGRULAMADIGIMIZ SEYLER
# ==========================================================================
# Linux bizim ACPI'mizle aciliyor, Windows acilmiyor. Fark, Linux'un
# hosgorup Windows'un hosgormedigi seylerde. Asagidakilerin hepsini Linux
# bedavaya soyluyor ve hicbirine bakmamistik.
#
say "======== WINDOWS ICIN KRITIK ========"

#
# 1) HANGI EXCEPTION LEVEL'DA ACILIYORUZ
#
# EN ONEMLISI. Windows ARM64 cekirdegi EL1'de calisir; EL2'de baslatilirsa
# ne yapacagi belirsiz. Mu-Silicium'un bellek haritasinda "EL2 Code" diye
# 2 MB'lik bir bolge var (0x87000000), yani ortada bir EL2 stub'i dolasiyor.
# Linux acilirken bunu acikca yaziyor:
#     "CPU: All CPU(s) started at EL2"   ya da   "... at EL1"
# EL2 cikarsa bu, 12 saniyelik sessiz cokusun cok guclu bir adayi.
#
say "-- Exception Level (Windows EL1 bekler)"
dmesg | grep -i -E 'started at EL|Booting Linux.*EL' | head -3 | sayp

#
# 2) MIMARI ZAMANLAYICI FREKANSI
#
# GTDT'miz 9830'dan uyarlanmisti ve hic dogrulanmadi. Windows zamanlayici
# konusunda Linux'tan cok daha kati: sayac frekansini yanlis bilirse butun
# zaman asimlari olceksiz olur. Cokusun HER SEFERINDE ~12 saniyede olmasi
# sabit bir zaman asimina benziyor; yanlis olceklenmis bir 10 saniye
# tam olarak boyle gorunur.
#
say "-- Mimari zamanlayici (GTDT dogrulamasi)"
dmesg | grep -i -E 'arch_timer|architected timer' | head -4 | sayp

#
# 3) PSCI SURUMU VE CONDUIT
#
# FACP'de HVC'den SMC'ye gecince Linux 1 cekirdekten 8'e cikmisti. Windows
# ayni yolu kullaniyor; surumu ve conduit'i kayda geciriyoruz.
#
say "-- PSCI"
dmesg | grep -i psci | head -4 | sayp

#
# 4) GIC
#
# acpiview MADT'de GICR uyarilari vermisti. Linux hangi surumu bulmus,
# kac kesme hatti gormus?
#
say "-- GIC"
dmesg | grep -i -E 'GICv|GIC:|Interrupt Controller' | head -4 | sayp

#
# 5) KANCA KAYDINI LINUX TARAFINDAN OKU
#
# 0xCF000000'daki B2L Log bolgesi. EFI Shell zaten okuyor ama Linux'un da
# okuyabilmesi bagimsiz bir dogrulama - hem bolgenin gercekten orada
# oldugunu hem sifirlamayi atlattigini gosterir.
# (/dev/mem kisitliysa calismaz, sorun degil.)
#
say "-- B2L Log 0xCF000000 (kanca kaydi)"
if [ -c /dev/mem ] || mknod -m 600 /dev/mem c 1 1 2>/dev/null; then
    say "   +0x40 imza : $(devmem 0xCF000040 32 2>/dev/null || echo okunamadi)"
    say "   +0x80 imza : $(devmem 0xCF000080 32 2>/dev/null || echo okunamadi)"
    say "   +0x88 type : $(devmem 0xCF000088 32 2>/dev/null || echo okunamadi)"
    say "   +0x90 stat : $(devmem 0xCF000090 32 2>/dev/null || echo okunamadi)"
else
    say "   /dev/mem yok"
fi

say "======== /KRITIK ========"

say "-- ACPI tablolari"
if [ -d /sys/firmware/acpi/tables ]; then
    say "   $(ls /sys/firmware/acpi/tables/ | tr '\n' ' ')"
else
    say "   /sys/firmware/acpi YOK"
fi

say "-- CPU topolojisi (PPTT'den gelmeli)"
for c in /sys/devices/system/cpu/cpu[0-9]*; do
    [ -d "$c/topology" ] || continue
    say "   $(basename $c): pkg=$(cat $c/topology/physical_package_id 2>/dev/null)" \
        "cluster=$(cat $c/topology/cluster_id 2>/dev/null)" \
        "core=$(cat $c/topology/core_id 2>/dev/null)"
done

say "-- ACPI aygitlari (DSDT'deki UFS0 gorunuyor mu)"
ACPIDEV="$(ls /sys/bus/acpi/devices/ 2>/dev/null | grep -i -E 'SMSN|UFS' | tr '\n' ' ')"
say "   ${ACPIDEV:-YOK}"

say "-- blok cihazlar (depolama var mi)"
BD="$(ls /dev/sd* /dev/block/sd* 2>/dev/null | tr '\n' ' ')"
say "   ${BD:-YOK}"

# --- depolama varsa tam logu dosyaya yaz ----------------------------------
ESP=""
for d in /dev/sd?? /dev/sd??? /dev/block/sd?? /dev/block/sd???; do
    [ -b "$d" ] || continue
    mount -t vfat "$d" /mnt 2>/dev/null || continue
    if [ -f /mnt/EFI/BOOT/BOOTAA64.EFI ]; then ESP="$d"; break; fi
    umount /mnt
done

if [ -n "$ESP" ]; then
    say "ESP bulundu: $ESP  -> KLOG.TXT yaziliyor"
    L=/mnt/KLOG.TXT
    {
        echo "########## dmesg ##########";            dmesg
        echo; echo "########## cpuinfo ##########";    cat /proc/cpuinfo
        echo; echo "########## ACPI tablolari ##########"
        ls -l /sys/firmware/acpi/tables/ 2>/dev/null
        echo; echo "########## interrupts ##########"; cat /proc/interrupts
        echo; echo "########## iomem ##########";      cat /proc/iomem
    } > "$L" 2>&1
    sync
    say "Yazildi: $L ($(wc -c < $L) bayt) - recovery'den cache'i cek"
    umount /mnt
    sync
else
    say "DEPOLAMA YOK (ACPI acilisinda bekleniyor, DSDT'de UFS dugumu yok)"
    say "Yukaridaki ozeti fotografla."
fi

say "======== bitti ========"

# init ASLA cikmamali.
while true; do sleep 3600; done
